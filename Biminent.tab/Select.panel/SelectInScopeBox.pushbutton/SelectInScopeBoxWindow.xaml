<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select in Scope Box"
        Width="860" Height="620"
        MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand accent strip along the bottom edge -->
        <Border Grid.Row="1" Height="4" Background="{DynamicResource HeaderGradientBrush}"/>

        <Grid Grid.Row="0" Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: scope boxes -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scope boxes" Style="{DynamicResource HeadingSmallStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="lbl_scope_count" Text="0/0"
                                   VerticalAlignment="Bottom"
                                   Style="{DynamicResource SecondaryTextSmallStyle}"
                                   ToolTip="Checked / all scope boxes"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Search scope boxes" Style="{DynamicResource CaptionStyle}" Margin="0,10,0,3"/>
                    <TextBox Grid.Row="2" x:Name="tb_scope_filter" TextChanged="scope_filter_changed"
                             ToolTip="Show only scope boxes whose name contains this text"/>

                    <ListBox Grid.Row="3" x:Name="list_scopes" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding checked}"
                                          Checked="scope_checked" Unchecked="scope_unchecked"
                                          Content="{Binding Label}"
                                          ToolTip="{Binding Label}"
                                          VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Check All" Click="scopes_check_all"
                                Style="{DynamicResource SmallButtonStyle}" Margin="0,0,6,0"
                                ToolTip="Check all visible scope boxes"/>
                        <Button Grid.Column="1" Content="Check None" Click="scopes_check_none"
                                Style="{DynamicResource SmallButtonStyle}"
                                ToolTip="Uncheck all visible scope boxes"/>
                    </Grid>
                </Grid>

                <!-- Right: categories -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Categories" Style="{DynamicResource HeadingSmallStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="lbl_cat_count" Text="0/0"
                                   VerticalAlignment="Bottom"
                                   Style="{DynamicResource SecondaryTextSmallStyle}"
                                   ToolTip="Checked / all categories"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Search categories" Style="{DynamicResource CaptionStyle}" Margin="0,10,0,3"/>
                    <TextBox Grid.Row="2" x:Name="tb_cat_filter" TextChanged="cat_filter_changed"
                             ToolTip="Show only categories whose name contains this text"/>

                    <ListBox Grid.Row="3" x:Name="list_cats" Margin="0,8,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding checked}"
                                          Checked="cat_checked" Unchecked="cat_unchecked"
                                          Content="{Binding Label}"
                                          ToolTip="{Binding Label}"
                                          VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Check All" Click="cats_check_all"
                                Style="{DynamicResource SmallButtonStyle}" Margin="0,0,6,0"
                                ToolTip="Check all visible categories"/>
                        <Button Grid.Column="1" Content="Check None" Click="cats_check_none"
                                Style="{DynamicResource SmallButtonStyle}"
                                ToolTip="Uncheck all visible categories"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Level filter -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Limit to level" VerticalAlignment="Center"
                           Margin="0,0,10,0" Style="{DynamicResource CaptionStyle}"/>
                <ComboBox Grid.Column="1" x:Name="cb_level"
                          DisplayMemberPath="Label"
                          ToolTip="Only select elements on this level (All levels = no level filter)"/>
            </Grid>

            <!-- Bottom bar -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="brand_logo" Height="24" Width="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="brand_wordmark" Text="BIMINENT" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource PrimaryFontFamily}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock x:Name="status_text" Text="" Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Style="{DynamicResource SecondaryTextSmallStyle}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Click="button_close"
                        Style="{DynamicResource GhostButtonStyle}"/>
                <Button Grid.Column="3" x:Name="btn_select" Content="Select"
                        Click="do_select" IsDefault="True" IsEnabled="False"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
