    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "#Viktor Kuzev 2019 viktor.kuzev@gmail.com\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Import DocumentManager and TransactionManager\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\n#The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\nfiles = IN[0]\r\nview = doc.ActiveView\r\n\r\n\r\n\r\noptions = DWGImportOptions()\r\noptions.AutoCorrectAlmostVHLines = IN[4]\r\noptions.ColorMode = IN[1]\r\noptions.OrientToView = IN[5]\r\noptions.ThisViewOnly = IN[6]\r\noptions.VisibleLayersOnly = True\r\noptions.Unit = IN[3]\r\noptions.Placement = IN[2]\r\nlinkedElem = clr.Reference[ElementId]()\r\ndirectoryStr = IN[8]+\"\\\\\"\r\n\r\nnames = []\r\nif IN[7]:\r\n\tTransactionManager.Instance.EnsureInTransaction(doc)\r\n\tfor filePath in files:\r\n\t\ttry:\r\n\t\t\t\t\t\r\n\t\t\tdoc.Link(filePath, options, view, linkedElem)\r\n\t\t\r\n\t\t\t\r\n\t\texcept: pass\r\n\tTransactionManager.Instance.TransactionTaskDone()\r\nelse:\r\n\tviewTypeColl = FilteredElementCollector(doc).OfClass(ViewFamilyType)\r\n\tfor i in viewTypeColl:\r\n\t\tif i.ViewFamily == ViewFamily.Drafting:\r\n\t\t\tviewType = i\r\n\t\telse:\r\n\t\t\tcontinue\r\n\t\t\t\r\n\tTransactionManager.Instance.EnsureInTransaction(doc)\r\n\tfor filePath in files:\r\n\t\tview = ViewDrafting.Create(doc, viewType.Id)\r\n\t\tname = filePath.split(\".dwg\")[0]\r\n\t\tname = name.split(directoryStr)[1]\r\n\t\tnames.append(name)\r\n\t\tdoc.Link(filePath, options, view, linkedElem)\r\n\t\tview.Name = name\r\n\tTransactionManager.Instance.TransactionTaskDone()\r\nOUT = files",
      "VariableInputPorts": true,
      "Id": "e3e06863997b40cc8ae867a1ec1618ca",
      "Inputs": [
