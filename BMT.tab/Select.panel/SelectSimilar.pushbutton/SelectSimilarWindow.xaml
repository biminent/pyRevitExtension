<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Similar"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand accent strip along the bottom edge -->
        <Border Grid.Row="1" Height="4" Background="{DynamicResource HeaderGradientBrush}"/>

        <StackPanel Grid.Row="0" Margin="16,12,16,12">

            <TextBlock Text="Seed element" Style="{DynamicResource HeadingSmallStyle}"
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock x:Name="lbl_seed" Text="" Margin="0,4,0,0"
                       Style="{DynamicResource BodySmallStyle}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="Match by" Style="{DynamicResource HeadingSmallStyle}"
                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,16,0,4"/>
            <RadioButton x:Name="rb_category" GroupName="match" Content="Category"
                         IsChecked="True" Checked="mode_changed" Margin="0,2,0,0"
                         ToolTip="All elements of the same category"/>
            <RadioButton x:Name="rb_family" GroupName="match" Content="Family"
                         Checked="mode_changed" Margin="0,2,0,0"
                         ToolTip="Same category and family"/>
            <RadioButton x:Name="rb_type" GroupName="match" Content="Type"
                         Checked="mode_changed" Margin="0,2,0,0"
                         ToolTip="Same element type"/>
            <RadioButton x:Name="rb_param" GroupName="match" Content="Instance parameter value"
                         Checked="mode_changed" Margin="0,2,0,0"
                         ToolTip="Same category, with the same value for the chosen instance parameter"/>

            <TextBlock Text="Parameter" Style="{DynamicResource CaptionStyle}" Margin="20,8,0,3"/>
            <ComboBox x:Name="cb_param" Margin="20,0,0,0"
                      DisplayMemberPath="Label" IsEnabled="False"
                      SelectionChanged="param_changed"
                      ToolTip="Match elements whose value for this instance parameter equals the seed's"/>

            <TextBlock Text="Search in" Style="{DynamicResource HeadingSmallStyle}"
                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,16,0,4"/>
            <RadioButton x:Name="rb_view" GroupName="scope" Content="Active view"
                         IsChecked="True" Margin="0,2,0,0"
                         ToolTip="Only elements visible in the active view"/>
            <RadioButton x:Name="rb_model" GroupName="scope" Content="Whole model"
                         Margin="0,2,0,0"
                         ToolTip="Every matching element in the project"/>

            <!-- Bottom bar -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="brand_logo" Height="24" Width="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="brand_wordmark" Text="BIMINENT" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource PrimaryFontFamily}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Click="button_close"
                        Style="{DynamicResource GhostButtonStyle}"/>
                <Button Grid.Column="3" x:Name="btn_select" Content="Select"
                        Click="do_select" IsDefault="True"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </Grid>

            <TextBlock x:Name="status_text" Text="" Margin="0,10,0,0"
                       Style="{DynamicResource SecondaryTextSmallStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
